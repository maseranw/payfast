{
  "name": "@ngelekanyo/payfast",
  "version": "1.0.0",
  "type": "module",
  "description": "Unified PayFast subscription toolkit: core signing/ITN utilities, an Express router, and a browser client",
  "author": "Ngelekanyo Masera <ngelekanyo@gmail.com>",
  "license": "MIT",
  "keywords": [
    "payfast",
    "subscription",
    "nodejs",
    "express",
    "payment",
    "gateway",
    "client",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maseranw/payfast.git"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/cjs/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/cjs/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/cjs/client/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && node scripts/write-cjs-package-json.cjs",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-extensions.cjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "cors": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "files": [
    "dist/**/*",
    "package.json",
    "README.md"
  ],
  "bugs": {
    "url": "https://github.com/maseranw/payfast/issues"
  },
  "homepage": "https://github.com/maseranw/payfast#readme"
}
